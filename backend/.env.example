# Copy this file to .env and fill in real values. Never commit the real .env.

# Postgres (Neon) connection string — production default. Get this from your
# Neon project dashboard (neon.tech): Project -> Connection Details.
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Leave DATABASE_URL unset (or use the line below) for zero-setup local dev —
# this is the same fallback backend/database.py uses automatically:
# DATABASE_URL=sqlite:///./cashpilot.db

# Google Gemini API key. AI features (extraction, AI CFO, chat, negotiation
# emails) are disabled gracefully if this is unset.
GOOGLE_API_KEY=your_gemini_api_key

# Secret used to sign JWT session/reset tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated per-process (dev-only — invalidates all
# sessions on every restart).
JWT_SECRET_KEY=

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:8080

# Used to build the password-reset link that gets logged server-side.
FRONTEND_URL=http://localhost:5173
